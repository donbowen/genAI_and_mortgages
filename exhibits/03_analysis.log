> -----
.         * Panel B: LLM outcomes by experiment (an observation can be in sever
> al experiments)
.         *--------------------------------------------------------------------
> -----
. 
.         preserve

.                 local exp_label "\expMain \expAsianHispanic \expLLMs \expName
> s \expCities \expMitigation \expAltMitigation \expMitigationName \expMitigati
> onCity"

.                 local exp_macro "exp1 exp2 exp3 exp4 exp5 exp6a exp6b exp6c e
> xp6d"

.                 local n : word count `exp_label'

. 
.                 tempfile stacked

.                 forvalues i = 1/`n' {
  2.                         local b : word `i' of `exp_macro'
  3.                         use `analysis' if ${`b'}, clear
  4.                         keep gpt_approval gpt_interest_rate
  5.                         gen byte experiment = `i'
  6.                         if `i' > 1 append using `stacked'
  7.                         qui save `stacked', replace
  8.                 }

. 
.                 cap label drop experiment_lbl

.                 forvalues i = 1/`n' {
  2.                         local a : word `i' of `exp_label'
  3.                         label define experiment_lbl `i' `"`a'"', add
  4.                 }

.                 label values experiment experiment_lbl

.                 label var experiment "Experiment"

.                 label var gpt_interest_rate "Rate (LLM, %)"

.                 tab experiment

