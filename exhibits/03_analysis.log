----------------------------------------------- python (type end to exit) -----
>>> import sys, pandas
>>> print(f"Stata's Python: {sys.version.split()[0]}, pandas {pandas.__version_
> _}")
Stata's Python: 3.13.5, pandas 2.2.3
>>> end
-------------------------------------------------------------------------------

. 
.         * Stata's Python (pandas) is used only for Table A1, to read the 700 
> MB LAR file
.         * without loading every column.
. 
. *****************************************************************************
> ***
. * 1. LOAD DATA AND DEFINE EXPERIMENTS
. *****************************************************************************
> ***
. 
.         import delimited using output_data/experiment_results.csv, clear bind
> quote(strict)
(encoding automatically selected: ISO-8859-9)
(29 vars, 170,000 obs)

.         foreach v in race gender name_race name_used city_race city_used loan
> _sequence_number {
  2.                 confirm string variable `v'
  3.         }

. 
.         *--------------------------------------------------------------------
> -
.         * the demographic signal in each prompt
.         *--------------------------------------------------------------------
> -
. 
.         * `race` is the race shown in the prompt; for the name and city exper
> iments
.         * it is the race the name or city signals; "None" if the prompt has n
> o race
.         replace race = "None"    if missing(race)
(43,000 real changes made)

.         replace race = name_race if block == "names"
(12,000 real changes made)

.         replace race = city_race if block == "cities"
(12,000 real changes made)

. 
.         label define race_c 1 "Asian" 2 "Black" 3 "Hispanic" 4 "None" 5 "Whit
> e"

.         encode race, gen(race_c) label(race_c)          // White (5) is the b
> ase category below

. 
.         encode gender, gen(gender_c)                    // 1 Female, 2 Male

. 
.         g mitigate   = prompt_version != "baseline"     // mitigation or alte
> rnative (ECOA) mitigation prompt

.         g name_black = name_race == "Black" if block == "names"
(158,000 missing values generated)

.         g city_black = city_race == "Black" if block == "cities"
(158,000 missing values generated)

. 
.         g actually_approved = action_taken == 1

. 
.         *--------------------------------------------------------------------
> -
.         * DTI: HMDA reports 36-49 exactly and buckets outside that range
.         *--------------------------------------------------------------------
> -
. 
.         replace debt_to_income_ratio = ""   if debt_to_income_ratio == "NA%"
(0 real changes made)

.         replace debt_to_income_ratio = "20" if debt_to_income_ratio == "<20%"
(8,858 real changes made)

.         replace debt_to_income_ratio = "60" if debt_to_income_ratio == ">60%"
(2,688 real changes made)

.         replace debt_to_income_ratio = "55" if debt_to_income_ratio == "50%-6
> 0%"
(4,906 real changes made)

.         replace debt_to_income_ratio = "25" if debt_to_income_ratio == "20%-<
> 30%"
(31,604 real changes made)

.         replace debt_to_income_ratio = "33" if debt_to_income_ratio == "30%-<
> 36%"
(28,302 real changes made)

.         replace debt_to_income_ratio = subinstr(debt_to_income_ratio,"%","",.
> )
(93,642 real changes made)

.         destring debt_to_income_ratio, replace
debt_to_income_ratio: all characters numeric; replaced as byte

. 
.         *--------------------------------------------------------------------
> -
.         * labels (", z)" is appended when a variable is standardized)
.         *--------------------------------------------------------------------
> -
. 
.         lab var gpt_approval                 "Approval (LLM)"

.         lab var gpt_interest_rate            "Rate (LLM)"

.         lab var score                        "CreditScore (Exp."

.         lab var actually_approved            "Approval (Actual)"

.         lab var interest_rate                "Rate (Actual)"

.         lab var rate_spread                  "Rate Spread (Actual)"

.         lab var debt_to_income_ratio         "DTI (Actual"

.         lab var combined_loan_to_value_ratio "LTV (Actual"

.         lab var mitigate                     "Mitigation"

.         lab var name_black                   "BlackName"

.         lab var city_black                   "BlackCity"

. 
.         *--------------------------------------------------------------------
> -
.         * experiment globals (Table 1)
.         *--------------------------------------------------------------------
> -
. 
.         global base_llm   model == "gpt-4-0125-preview"

.         global bw         inlist(race, "Black", "White")

. 
.         global exp1   block == "race" & $base_llm & prompt_version == "baseli
> ne" & $bw

.         global exp2   block == "race" & $base_llm & prompt_version == "baseli
> ne"

.         global exp3   block == "race"             & prompt_version == "baseli
> ne" & $bw

.         global exp4   block == "names"  & prompt_version == "baseline"

.         global exp5   block == "cities" & prompt_version == "baseline"

.         global exp6a  block == "race" & $base_llm & inlist(prompt_version, "b
> aseline", "mitigate")      & $bw

.         global exp6b  block == "race" & $base_llm & inlist(prompt_version, "b
> aseline", "mitigate_ecoa") & $bw

.         global exp6c  block == "names"

.         global exp6d  block == "cities"

.         global exp7a  block == "actual_credit" & race == "None"

.         global exp7b  block == "actual_credit" & race != "None"

.         global expA1  block == "age"

.         global expA2  block == "gender"

.         global exp1R  block == "rerun_jul2024" & temperature == 0     // Tabl
> e A2, cols 1-4

.         global exp1T  block == "rerun_jul2024" & temperature > 0      // Tabl
> e A2, cols 5-8 (temperature 0.3)

. 
.         *--------------------------------------------------------------------
> -
.         * answer rates (Exp. 3), then keep calls with a well-formatted reply
.         *--------------------------------------------------------------------
> -
. 
.         g answered = !missing(gpt_approval)

.         egen ans_rate = mean(100*answered) if $exp3, by(model race)
(74,000 missing values generated)

.         tab model race if $exp3, sum(ans_rate) mean nost nofreq

