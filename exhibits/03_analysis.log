.         di _n "Table 1: N by experiment"

Table 1: N by experiment

.         foreach e in 1 2 3 4 5 6a 6b 6c 6d 7a 7b A1 A2 1R 1T {
  2.                 qui count if ${exp`e'}
  3.                 di "  Experiment `e'" _col(20) %9.0fc r(N)
  4.         }
