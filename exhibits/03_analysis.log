. *****************************************************************************
> ***
. * 0. SETUP AND PACKAGES
. *****************************************************************************
> ***
. 
.         foreach p in reghdfe ftools center coefplot binscatter winsor estout 
> schemepack {
  2.                 cap which `p'
  3.                 if _rc & "`p'" == "schemepack" cap findfile scheme-white_h
> ue.scheme
  4.                 if _rc ssc install `p', replace
  5.         }

.         cap which grc1leg

.         if _rc net install grc1leg, from("http://www.stata.com/users/vwiggins
> ") replace

.         cap reghdfe, compile

. 
.         * record the software versions used in the log (no license or path de
> tails)
.         di "Stata " c(stata_version) " (" c(edition_real) "), executable date
> d " c(born_date) ", " c(os)
Stata 19.5 (MP), executable dated 06 Oct 2025, Windows

.         foreach p in reghdfe ftools center coefplot binscatter winsor estout 
> grc1leg {
  2.                 qui findfile `p'.ado
  3.                 tempname fh
  4.                 file open `fh' using `"`r(fn)'"', read text
  5.                 file read `fh' line
  6.                 while r(eof) == 0 & substr(`"`macval(line)'"', 1, 2) != "*
> !" {
  7.                         file read `fh' line
  8.                 }
  9.                 file close `fh'
 10.                 di `"  `p': `macval(line)'"'
 11.         }
